<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:cardview="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/spacing_8">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/spacing_8"
        cardview:cardCornerRadius="@dimen/corner_radius_8"
        cardview:cardElevation="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_12"
            android:background="@color/white">

            <TextView
                android:id="@+id/titleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Notification Title"
                android:textSize="@dimen/text_size_16"
                android:textStyle="bold"
                android:layout_marginBottom="@dimen/spacing_4" />

            <TextView
                android:id="@+id/messageText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Notification message"
                android:textSize="@dimen/text_size_14"
                android:textColor="@color/gray"
                android:layout_marginBottom="@dimen/spacing_8" />

            <TextView
                android:id="@+id/timeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Just now"
                android:textSize="@dimen/text_size_12"
                android:textColor="@color/dark_gray"
                android:layout_marginBottom="@dimen/spacing_8" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="end"
                android:spacing="@dimen/spacing_8">

                <Button
                    android:id="@+id/markReadButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mark Read"
                    android:textSize="@dimen/text_size_12"
                    android:paddingStart="@dimen/spacing_8"
                    android:paddingEnd="@dimen/spacing_8"
                    android:paddingTop="@dimen/spacing_4"
                    android:paddingBottom="@dimen/spacing_4"
                    android:background="?attr/selectableItemBackground"
                    android:layout_marginEnd="@dimen/spacing_8" />

                <Button
                    android:id="@+id/archiveButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Archive"
                    android:textSize="@dimen/text_size_12"
                    android:paddingStart="@dimen/spacing_8"
                    android:paddingEnd="@dimen/spacing_8"
                    android:paddingTop="@dimen/spacing_4"
                    android:paddingBottom="@dimen/spacing_4"
                    android:background="?attr/selectableItemBackground"
                    android:layout_marginEnd="@dimen/spacing_8" />

                <Button
                    android:id="@+id/deleteButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Delete"
                    android:textSize="@dimen/text_size_12"
                    android:paddingStart="@dimen/spacing_8"
                    android:paddingEnd="@dimen/spacing_8"
                    android:paddingTop="@dimen/spacing_4"
                    android:paddingBottom="@dimen/spacing_4"
                    android:background="?attr/selectableItemBackground" />

            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</LinearLayout>
